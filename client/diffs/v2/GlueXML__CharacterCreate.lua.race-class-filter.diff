+
+-- ShadowCore 0.2.0 (17/10): as duas protecoes do patch de 13/10 que acabaram com os crashes/travas da criacao, de volta
+-- sobre a tela oficial nova. (1) uma carga por clique: o clique de raca carrega o modelo (SetCharacterRace) e o
+-- SetCharacterGender carrega a MESMA raca/sexo de novo no mesmo quadro, destruindo um modelo ainda sendo lido do disco.
+-- (2) so remonta os botoes de raca quando a lista ou o sexo mudam (19 dos 21 crashes eram nessa remontagem).
+do
+	local origRaceClick = CharacterRace_OnClick
+	local origSetRace = SetCharacterRace
+	local origShow = CharacterCreate_OnShow
+	local current
+	local inClick = false
+	function SetCharacterRace(...)
+		local key = tostring(GetSelectedRace()) .. ":" .. tostring(GetSelectedSex())
+		if inClick and key == current then
+			return
+		end
+		current = key
+		return origSetRace(...)
+	end
+	function CharacterRace_OnClick(...)
+		inClick = true
+		local ok, err = pcall(origRaceClick, ...)
+		inClick = false
+		if not ok then
+			error(err, 0)
+		end
+	end
+	function CharacterCreate_OnShow(...)
+		current = nil
+		return origShow(...)
+	end
+end
+do
+	local origEnumerate = CharacterCreateEnumerateRaces
+	local origShow = CharacterCreate_OnShow
+	local lastKey
+	function CharacterCreateEnumerateRaces(...)
+		local files = {}
+		for i = 2, select("#", ...), 3 do
+			files[#files + 1] = select(i, ...)
+		end
+		CharacterCreate_RaceFileByIndex = files
+		local parts = { tostring(GetSelectedSex()) }
+		for i = 1, select("#", ...) do
+			parts[#parts + 1] = tostring((select(i, ...)))
+		end
+		local key = table.concat(parts, "|")
+		if key == lastKey then
+			return
+		end
+		lastKey = key
+		return origEnumerate(...)
+	end
+	function CharacterCreate_OnShow(...)
+		lastKey = nil
+		return origShow(...)
+	end
+end

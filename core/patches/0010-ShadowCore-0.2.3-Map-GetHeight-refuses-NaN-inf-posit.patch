From 2207d7a0b708c28a592462cc4cfac4b1a86614d9 Mon Sep 17 00:00:00 2001
From: CoA Reborn Classes contributors <noreply@example.invalid>
Date: Sat, 17 Oct 2026 21:47:31 +0900
Subject: [PATCH] ShadowCore 0.2.3: Map::GetHeight refuses NaN/inf positions
 (VMAP ray walk never ended)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/server/game/Maps/Map.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/server/game/Maps/Map.cpp b/src/server/game/Maps/Map.cpp
index b75622972..aa3fdcdec 100644
--- a/src/server/game/Maps/Map.cpp
+++ b/src/server/game/Maps/Map.cpp
@@ -45,6 +45,7 @@
 #include "VMapMgr2.h"
 #include "Weather.h"
 #include "WeatherMgr.h"
+#include <cmath>
 
 #define MAP_INVALID_ZONE        0xFFFFFFFF
 
@@ -1171,6 +1172,10 @@ Transport* Map::GetTransportForPos(uint32 phase, float x, float y, float z, Worl
 
 float Map::GetHeight(float x, float y, float z, bool checkVMap /*= true*/, float maxSearchDist /*= DEFAULT_HEIGHT_SEARCH*/) const
 {
+    // ShadowCore: a NaN/inf position never ends the VMAP ray walk (World Thread hangs, 17/10/2026)
+    if (!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z))
+        return INVALID_HEIGHT;
+
     // find raw .map surface under Z coordinates
     float mapHeight = VMAP_INVALID_HEIGHT_VALUE;
     float gridHeight = GetGridHeight(x, y);
@@ -1590,6 +1595,9 @@ bool Map::isInLineOfSight(float x1, float y1, float z1, float x2, float y2, floa
 
 float Map::GetHeight(uint32 phasemask, float x, float y, float z, bool vmap/*=true*/, float maxSearchDist /*= DEFAULT_HEIGHT_SEARCH*/) const
 {
+    if (!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z))
+        return INVALID_HEIGHT;
+
     float h1, h2;
     h1 = GetHeight(x, y, z, vmap, maxSearchDist);
     h2 = _mapCollisionData.GetDynamicTree().getHeight(x, y, z, maxSearchDist, phasemask);
-- 

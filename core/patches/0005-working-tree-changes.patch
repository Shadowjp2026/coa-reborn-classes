+    // Classic Support specializations: the exclusive skill line and the spells bought at the
+    // book follow the active specialization. While Support is active the skill exists and the
+    // previously bought spells are restored; while another specialization is active the spells
+    // are parked in a player setting (one bit per spell) and the skill is removed, so nothing
+    // is lost and nothing needs a second purchase. Prototype scope: Paladin only.
+    struct ClassicSupportSpec
+    {
+      uint8 ClassId;
+      uint32 SpecId;
+      uint32 SkillId;
+      std::array<uint32, 12> Spells;
+      char const* Setting;
+    };
+    static constexpr std::array<ClassicSupportSpec, 1> ClassicSupportSpecs{ {
+        { CLASS_PALADIN, 102, 11901, { 2600000u }, "coa.support.paladin" },
+    } };
+
+    static uint32 SynchronizeClassicSupport(Player* player, uint32 activeSpec)
+    {
+      uint32 changed = 0;
+      for (ClassicSupportSpec const& spec : ClassicSupportSpecs)
+      {
+        if (player->getClass() != spec.ClassId)
+          continue;
+        if (activeSpec == spec.SpecId)
+        {
+          if (!player->HasSkill(spec.SkillId))
+            player->LearnDefaultSkill(spec.SkillId, 0);
+          uint32 const owned = uint32(player->GetPlayerSetting(spec.Setting, 0).value);
+          for (std::size_t index = 0; index < spec.Spells.size(); ++index)
+            if (spec.Spells[index] && (owned & (1u << index)) && !player->HasSpell(spec.Spells[index]) &&
+                sSpellMgr->GetSpellInfo(spec.Spells[index]))
+            {
+              player->learnSpell(spec.Spells[index], false);
+              ++changed;
+            }
+        }
+        else if (player->HasSkill(spec.SkillId))
+        {
+          uint32 owned = uint32(player->GetPlayerSetting(spec.Setting, 0).value);
+          for (std::size_t index = 0; index < spec.Spells.size(); ++index)
+            if (spec.Spells[index] && player->HasSpell(spec.Spells[index]))
+            {
+              owned |= (1u << index);
+              player->removeSpell(spec.Spells[index], SPEC_MASK_ALL, false);
+              ++changed;
+            }
+          player->UpdatePlayerSetting(spec.Setting, 0, owned);
+          // the skill line itself stays: the Support tab remains part of the book, only the
+          // exclusive spells are parked while another specialization is active.
+        }
+      }
+      return changed;
+    }

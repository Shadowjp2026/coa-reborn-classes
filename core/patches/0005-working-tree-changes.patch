diff --git a/src/server/coa/AscensionSupportPaladin.cpp b/src/server/coa/AscensionSupportPaladin.cpp
new file mode 100644
index 0000000000..3aebc466cb
--- /dev/null
+++ b/src/server/coa/AscensionSupportPaladin.cpp
@@ -0,0 +1,153 @@
+/* Copyright (C) 2016+ AzerothCore, GNU AGPL v3. */
+
+// [SUPPORT-V2] Paladin Support: Beacon of Virtue (1277680) had only dummy effects and no script.
+// Cast: the target and up to 4 injured allies (5 with Beacon Mastery) within 30 yards get the
+// Beacon of Virtue mark (1277682) from the paladin. While marked, the paladin's Holy Light and
+// Flash of Light also heal every other marked ally for 25% (1277684) through 1277681.
+
+#include "CellImpl.h"
+#include "GridNotifiers.h"
+#include "GridNotifiersImpl.h"
+#include "Group.h"
+#include "Player.h"
+#include "ScriptMgr.h"
+#include "SpellAuras.h"
+#include "SpellInfo.h"
+#include "SpellMgr.h"
+#include "SpellScript.h"
+
+namespace
+{
+enum SupportPaladinSpells : uint32
+{
+    SPELL_BEACON_OF_VIRTUE        = 1277680,
+    SPELL_BEACON_OF_VIRTUE_HEAL   = 1277681,
+    SPELL_BEACON_OF_VIRTUE_MARK   = 1277682,
+    SPELL_BEACON_OF_VIRTUE_AMOUNT = 1277684,
+    SPELL_BEACON_MASTERY          = 2600009
+};
+
+constexpr float BEACON_ALLY_RADIUS = 30.0f;
+constexpr float BEACON_HEAL_RANGE = 60.0f;
+constexpr uint32 BEACON_EXTRA_ALLIES = 4;
+constexpr int32 BEACON_MASTERY_BONUS_MS = 10000;
+
+std::vector<Unit*> MarkedAllies(Player* paladin, float range)
+{
+    std::list<Unit*> nearby;
+    Acore::AnyFriendlyUnitInObjectRangeCheck check(paladin, paladin, range);
+    Acore::UnitListSearcher<Acore::AnyFriendlyUnitInObjectRangeCheck> searcher(paladin, nearby, check);
+    Cell::VisitObjects(paladin, searcher, range);
+    nearby.push_back(paladin);
+
+    std::vector<Unit*> marked;
+    for (Unit* unit : nearby)
+        if (unit && unit->IsAlive() && unit->HasAura(SPELL_BEACON_OF_VIRTUE_MARK, paladin->GetGUID()) &&
+            std::find(marked.begin(), marked.end(), unit) == marked.end())
+            marked.push_back(unit);
+    return marked;
+}
+
+class spell_coa_beacon_of_virtue : public SpellScript
+{
+    PrepareSpellScript(spell_coa_beacon_of_virtue);
+
+    bool Validate(SpellInfo const* /*spellInfo*/) override
+    {
+        return ValidateSpellInfo({ SPELL_BEACON_OF_VIRTUE_HEAL, SPELL_BEACON_OF_VIRTUE_MARK, SPELL_BEACON_OF_VIRTUE_AMOUNT });
+    }
+
+    void ClearDefaultAura()
+    {
+        // The stock dummy aura (effect 1) carries no behaviour; the mark below is the real beacon.
+        if (Aura* aura = GetHitAura())
+            aura->Remove();
+    }
+
+    void ApplyBeacons()
+    {
+        Player* paladin = GetCaster() ? GetCaster()->ToPlayer() : nullptr;
+        Unit* target = GetExplTargetUnit();
+        if (!paladin || !target)
+            return;
+
+        for (Unit* previous : MarkedAllies(paladin, BEACON_HEAL_RANGE))
+            previous->RemoveAurasDueToSpell(SPELL_BEACON_OF_VIRTUE_MARK, paladin->GetGUID());
+
+        bool const mastery = paladin->HasAura(SPELL_BEACON_MASTERY);
+        uint32 const extra = BEACON_EXTRA_ALLIES + (mastery ? 1 : 0);
+
+        std::vector<Unit*> allies;
+        if (Group* group = paladin->GetGroup())
+        {
+            for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                if (Player* member = ref->GetSource())
+                    if (member != target && member->IsInMap(target) && member->IsAlive() &&
+                        member->IsWithinDistInMap(target, BEACON_ALLY_RADIUS) && member->IsFullHealth() == false)
+                        allies.push_back(member);
+        }
+        else if (paladin != target && paladin->IsWithinDistInMap(target, BEACON_ALLY_RADIUS) && !paladin->IsFullHealth())
+            allies.push_back(paladin);
+
+        std::sort(allies.begin(), allies.end(), [](Unit const* left, Unit const* right)
+        {
+            return left->GetHealthPct() < right->GetHealthPct();
+        });
+        if (allies.size() > extra)
+            allies.resize(extra);
+        allies.insert(allies.begin(), target);
+
+        for (Unit* ally : allies)
+            if (Aura* mark = paladin->AddAura(SPELL_BEACON_OF_VIRTUE_MARK, ally))
+                if (mastery)
+                {
+                    mark->SetMaxDuration(mark->GetMaxDuration() + BEACON_MASTERY_BONUS_MS);
+                    mark->SetDuration(mark->GetMaxDuration());
+                }
+    }
+
+    void Register() override
+    {
+        AfterHit += SpellHitFn(spell_coa_beacon_of_virtue::ClearDefaultAura);
+        AfterCast += SpellCastFn(spell_coa_beacon_of_virtue::ApplyBeacons);
+    }
+};
+
+bool CopiesToBeacons(SpellInfo const* info)
+{
+    if (!info || info->SpellFamilyName != SPELLFAMILY_PALADIN || !info->SpellName[0])
+        return false;
+    std::string_view const name = info->SpellName[0];
+    return name == "Holy Light" || name == "Flash of Light";
+}
+
+class coa_beacon_of_virtue_transfer : public UnitScript
+{
+public:
+    coa_beacon_of_virtue_transfer() : UnitScript("coa_beacon_of_virtue_transfer", true, { UNITHOOK_MODIFY_HEAL_RECEIVED }) { }
+
+    // Unit::HealBySpell calls this as (caster, heal target, heal, spell).
+    void ModifyHealReceived(Unit* caster, Unit* healed, uint32& heal, SpellInfo const* spellInfo) override
+    {
+        Player* paladin = caster ? caster->ToPlayer() : nullptr;
+        if (!paladin || !healed || !heal || paladin->getClass() != CLASS_PALADIN || !CopiesToBeacons(spellInfo))
+            return;
+
+        SpellInfo const* amountInfo = sSpellMgr->GetSpellInfo(SPELL_BEACON_OF_VIRTUE_AMOUNT);
+        int32 const pct = amountInfo ? amountInfo->Effects[EFFECT_0].CalcValue() : 25;
+        int32 const copy = int32(CalculatePct(heal, pct));
+        if (copy <= 0)
+            return;
+
+        for (Unit* beacon : MarkedAllies(paladin, BEACON_HEAL_RANGE))
+            if (beacon != healed)
+                paladin->CastCustomSpell(SPELL_BEACON_OF_VIRTUE_HEAL, SPELLVALUE_BASE_POINT0, copy, beacon, true);
+    }
+};
+}
+
+void AddSC_AscensionSupportPaladin()
+{
+    RegisterSpellScript(spell_coa_beacon_of_virtue);
+    new coa_beacon_of_virtue_transfer();
+}

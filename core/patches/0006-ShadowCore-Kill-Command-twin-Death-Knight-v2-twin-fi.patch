     NPC_RISEN_ALLY                              = 30230
 };
 
+// ShadowCore DK v2: o Death Knight classico usa as gemeas Reborn (+1100000). As pecas do Death Coil
+// nao sao "gemeas" no SpellMgr (o stock virou "Grave Coil"), entao a ligacao e feita aqui pelo deslocamento.
+// Para quem lanca o stock nada muda.
+namespace DkReborn
+{
+    constexpr uint32 OFFSET = 1100000;
+
+    uint32 PartFor(uint32 stockPart, uint32 castSpellId)
+    {
+        uint32 const twin = sSpellMgr->GetSpellTwinFor(stockPart, castSpellId);
+        if (twin != stockPart)
+            return twin;
+        return castSpellId > OFFSET && sSpellMgr->GetSpellInfo(stockPart + OFFSET) ? stockPart + OFFSET : stockPart;
+    }
+
+    bool Is(uint32 spellId, uint32 stockId)
+    {
+        return spellId == stockId || sSpellMgr->GetSpellTwinSource(spellId) == stockId || spellId == stockId + OFFSET;
+    }
+}
